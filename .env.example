# APP_DATA_NAME · 环境变量示例
# 用法：复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，请勿提交。
# 说明：AI 服务商密钥优先由「系统设置 → AI 服务商配置」界面保存至 data/ai_providers.json；
#       以下环境变量仅作为兜底（当界面未配置时生效），可选。

# ===== 服务端口 =====
# 局域网 Web 服务端口（默认 8100）；客户端通过 UDP 39997 广播配网数字自动发现服务器。
COOP_PORT=8100

# ===== Flask 会话密钥 =====
# 留空则每次启动随机生成（开发/测试可接受）；生产环境请固定一个长随机串以保证会话稳定。
COOP_SECRET=

# ===== 数据目录 =====
# 默认 %LOCALAPPDATA%\APP_DATA_NAME；可改为其他可写路径（数据库/导出/结算单/密钥均存于此）。
COOP_DATA=

# ===== AI 识别兜底密钥（可选）=====
# 仅当界面未配置对应服务商密钥时作为兜底读取，键名需与 ai_providers 的 env_prefix 对应。
COOP_AI_API_KEY=
AI_API_KEY=
